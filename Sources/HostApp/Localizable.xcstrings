    "Control display capture, transport, and local recording from the host runtime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Control display capture, transport, and local recording from the host runtime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从主机运行时控制显示器采集、传输和本地录制。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuern Sie Display-Aufnahme, Transport und lokale Aufzeichnung von der Host-Laufzeit aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez la capture d'écran, le transport et l'enregistrement local depuis l'environnement d'exécution hôte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्ट रनटाइम से डिस्प्ले कैप्चर, ट्रांसपोर्ट और स्थानीय रिकॉर्डिंग को नियंत्रित करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストランタイムからディスプレイキャプチャ、転送、ローカル録画を制御します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم في التقاط الشاشة والنقل والتسجيل المحلي من وقت تشغيل المضيف."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la cattura del display, il trasporto e la registrazione locale dal runtime host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle la captura de pantalla, el transporte y la grabación local desde el tiempo de ejecución del host."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle a captura de tela, transporte e gravação local a partir do runtime do host."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 런타임에서 디스플레이 캡처, 전송 및 로컬 녹화를 제어합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте захватом дисплея, транспортом и локальной записью из среды выполнения хоста."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從主機執行階段控制顯示器擷取、傳輸和本機錄製。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana bilgisayar çalışma zamanından ekran yakalama, aktarım ve yerel kaydı kontrol edin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer schermopname, transport en lokale opname vanaf de host-runtime."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluj przechwytywanie ekranu, transport i lokalne nagrywanie ze środowiska wykonawczego hosta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr skärminfångning, transport och lokal inspelning från värdkörningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมการจับภาพหน้าจอ การขนส่ง และการบันทึกในเครื่องจากรันไทม์โสต์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm soát thu thập màn hình, truyền tải và ghi cục bộ từ thời gian chạy máy chủ."
          }
        }
      }
    },
