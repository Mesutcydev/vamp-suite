    "App Sandbox limits this build to View Only. Download the direct build for full control.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox 限制了此版本为仅查看模式。请下载直接构建版以获得完整控制权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "App Sandbox limits this build to View Only. Download the direct build for full control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox beschränkt diese Version auf Nur-Anzeigen. Laden Sie den direkten Build für volle Kontrolle herunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox limite cette version à la visualisation seule. Téléchargez la version directe pour un contrôle complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सैंडबॉक्स इस बिल्ड को केवल देखने तक सीमित करता है। पूर्ण नियंत्रण के लिए डायरेक्ट बिल्ड डाउनलोड करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox によりこのビルドは表示のみに制限されています。完全な制御には直接ビルドをダウンロードしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحد App Sandbox هذا الإصدار إلى العرض فقط. قم بتنزيل الإصدار المباشر للتحكم الكامل."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox limita questa build alla sola visualizzazione. Scarica la build diretta per il controllo completo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox limita esta versión a solo visualización. Descarga la versión directa para control total."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox가 이 빌드를 보기 전용으로 제한합니다. 전체 제어를 위해 직접 빌드를 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Песочница приложений ограничивает эту сборку только просмотром. Загрузите прямую сборку для полного контроля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox bu yapıyı yalnızca görüntülemeyle sınırlar. Tam kontrol için doğrudan yapıyı indirin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox beperkt deze build tot alleen weergeven. Download de directe build voor volledige controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piaskownica aplikacji ogranicza tę wersję do trybu tylko do odczytu. Pobierz wersję bezpośrednią, aby uzyskać pełną kontrolę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox begränsar denna build till endast visning. Ladda ner den direkta builden för full kontroll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox จำกัดรุ่นนี้ให้ดูได้อย่างเดียว ดาวน์โหลดรุ่นโดยตรงเพื่อควบคุมเต็มรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox giới hạn bản dựng này ở chế độ chỉ xem. Tải bản dựng trực tiếp để có toàn quyền kiểm soát."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox limita esta versión a solo visualización. Descarga la versión directa para control total."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox 限制了此版本为仅查看模式。请下载直接构建版以获得完整控制权。"
          }
        }
      }
    },
