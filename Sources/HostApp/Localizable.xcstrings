    "Inspect permission readiness, transport health, capture throughput, and recent event history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Inspect permission readiness, transport health, capture throughput, and recent event history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查权限就绪情况、传输健康状况、采集吞吐量和最近事件历史。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Berechtigungsbereitschaft, den Transportzustand, den Aufnahmedurchsatz und den letzten Ereignisverlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez l'état des autorisations, la santé du transport, le débit de capture et l'historique récent des événements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति तत्परता, ट्रांसपोर्ट स्वास्थ्य, कैप्चर थ्रूपुट और हाल के ईवेंट इतिहास का निरीक्षण करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限の準備状況、トランスポートの健全性、キャプチャスループット、最近のイベント履歴を検査します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص جاهزية الأذونات، وصحة النقل، وإنتاجية الالتقاط، وسجل الأحداث الأخيرة."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispeziona la prontezza dei permessi, lo stato del trasporto, il throughput di cattura e la cronologia recente degli eventi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeccione la preparación de permisos, el estado del transporte, el rendimiento de captura y el historial reciente de eventos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione a prontidão de permissões, a saúde do transporte, a taxa de captura e o histórico recente de eventos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 준비 상태, 전송 상태, 캡처 처리량 및 최근 이벤트 기록을 검사합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте готовность разрешений, состояние транспорта, пропускную способность захвата и историю последних событий."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查權限就緒情況、傳輸健康狀態、擷取吞吐量和最近事件歷史記錄。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin hazırlığını, aktarım sağlığını, yakalama verimini ve son olay geçmişini inceleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecteer machtigingsgereedheid, transportstatus, opname-doorvoer en recente gebeurtenisgeschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź gotowość uprawnień, stan transportu, przepustowość przechwytywania i historię ostatnich zdarzeń."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspektera behörighetsberedskap, transporthälsa, infångningsgenomströmning och senaste händelsehistorik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบความพร้อมของสิทธิ์ สุขภาพการขนส่ง ปริมาณการจับภาพ และประวัติเหตุการณ์ล่าสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra mức sẵn sàng quyền, tình trạng truyền tải, thông lượng thu thập và lịch sử sự kiện gần đây."
          }
        }
      }
    },
