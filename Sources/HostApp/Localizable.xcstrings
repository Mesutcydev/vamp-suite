    "Display source, quality preset, and capture pipeline state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Display source, quality preset, and capture pipeline state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器源、质量预设和采集管线状态。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display-Quelle, Qualitätsvoreinstellung und Status der Aufnahme-Pipeline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source d'affichage, préréglage de qualité et état du pipeline de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्प्ले स्रोत, गुणवत्ता प्रीसेट और कैप्चर पाइपलाइन स्थिति।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイソース、品質プリセット、キャプチャパイプラインの状態。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر العرض، الإعداد المسبق للجودة، وحالة خط أنابيب الالتقاط."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgente display, preset di qualità e stato della pipeline di cattura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente de pantalla, preajuste de calidad y estado de la canalización de captura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonte de exibição, predefinição de qualidade e estado do pipeline de captura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 소스, 품질 사전 설정 및 캡처 파이프라인 상태."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник дисплея, предустановка качества и состояние конвейера захвата."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器來源、品質預設和擷取管線狀態。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
