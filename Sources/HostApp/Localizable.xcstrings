    "Up to 20 most recent runtime log entries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Up to 20 most recent runtime log entries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 20 条最近的运行时日志条目。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 20 der letzten Laufzeitprotokolleinträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à 20 entrées de journal d'exécution les plus récentes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम 20 सबसे हाल के रनटाइम लॉग प्रविष्टियाँ।"
          }
        },
        "ja": {
