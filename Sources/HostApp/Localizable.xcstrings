    "Encoder state, codec config, and WebRTC transport readiness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Encoder state, codec config, and WebRTC transport readiness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编码器状态、编解码器配置和 WebRTC 传输就绪情况。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoder-Status, Codec-Konfiguration und WebRTC-Transportbereitschaft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de l'encodeur, configuration du codec et disponibilité du transport WebRTC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एनकोडर स्थिति, कोडेक कॉन्फ़िगरेशन और WebRTC ट्रांसपोर्ट तत्परता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンコーダーの状態、コーデック設定、WebRTCトランスポートの準備状況。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة المشفر، تكوين برنامج الترميز، وجاهزية نقل WebRTC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato dell'encoder, configurazione del codec e disponibilità del trasporto WebRTC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado del codificador, configuración del códec y disponibilidad del transporte WebRTC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado do codificador, configuração do codec e prontidão do transporte WebRTC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인코더 상태, 코덱 구성 및 WebRTC 전송 준비 상태."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние кодировщика, конфигурация кодека и готовность транспорта WebRTC."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編碼器狀態、編解碼器設定和 WebRTC 傳輸就緒情況。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlayıcı durumu, kodek yapılandırması ve WebRTC aktarım hazırlığı."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
