    "Recording now writes a playable H.264 MP4 from the capture stream without disturbing the remote transport path.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Recording now writes a playable H.264 MP4 from the capture stream without disturbing the remote transport path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制现在从采集流中写入可播放的 H.264 MP4，不会干扰远程传输路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung schreibt jetzt eine abspielbare H.264-MP4-Datei aus dem Aufnahmestream, ohne den Remote-Transportpfad zu stören."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement écrit désormais un fichier MP4 H.264 lisible à partir du flux de capture sans perturber le chemin de transport à distance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग अब कैप्चर स्ट्रीम से एक चलाने योग्य H.264 MP4 लिखती है, बिना रिमोट ट्रांसपोर्ट पथ को बाधित किए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画は、リモート転送パスを妨げることなく、キャプチャストリームから再生可能なH.264 MP4を書き込むようになりました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم التسجيل الآن بكتابة ملف MP4 H.264 قابل للتشغيل من دفق الالتقاط دون إزعاج مسار النقل عن بُعد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione ora scrive un MP4 H.264 riproducibile dal flusso di cattura senza disturbare il percorso di trasporto remoto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación ahora escribe un MP4 H.264 reproducible desde el flujo de captura sin perturbar la ruta de transporte remoto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação agora grava um MP4 H.264 reproduzível do fluxo de captura sem perturbar o caminho de transporte remoto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화는 이제 원격 전송 경로를 방해하지 않고 캡처 스트림에서 재생 가능한 H.264 MP4를 기록합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись теперь создает воспроизводимый H.264 MP4 из потока захвата, не нарушая удаленный транспортный путь."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製現在從擷取串流寫入可播放的 H.264 MP4，不會干擾遠端傳輸路徑。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt artık uzak aktarım yolunu bozmadan yakalama akışından oynatılabilir bir H.264 MP4 yazıyor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname schrijft nu een afspeelbare H.264 MP4 van de opnamestream zonder het externe transportpad te verstoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zapisuje teraz odtwarzalny plik H.264 MP4 ze strumienia przechwytywania, nie zakłócając zdalnej ścieżki transportowej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelning skriver nu en spelbar H.264 MP4 från infångningsströmmen utan att störa fjärrtransportvägen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเขียนไฟล์ H.264 MP4 ที่เล่นได้จากสตรีมการจับภาพ โดยไม่รบกวนเส้นทางการขนส่งระยะไกล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi hình hiện ghi tệp MP4 H.264 có thể phát từ luồng thu thập mà không làm gián đoạn đường truyền từ xa."
          }
        }
      }
    },
