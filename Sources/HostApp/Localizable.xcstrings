        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन डिवाइसों की अब पहुंच नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのデバイスはアクセスできなくなりました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه الأجهزة تمتلك حق الوصول."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dispositivi non hanno più accesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos dispositivos ya no tienen acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses dispositivos não têm mais acesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 기기는 더 이상 액세스할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти устройства больше не имеют доступа."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些裝置不再具有存取權限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazların artık erişimi yok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze apparaten hebben geen toegang meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te urządzenia nie mają już dostępu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa enheter har inte längre åtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เหล่านี้ไม่มีสิทธิ์เข้าถึงอีกต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị này không còn quyền truy cập."
          }
        }
      }
    },
    "This device will no longer be able to control your Mac without re-approval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This device will no longer be able to control your Mac without re-approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备将无法再控制您的 Mac，除非重新批准。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann Ihren Mac ohne erneute Genehmigung nicht mehr steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne pourra plus contrôler votre Mac sans nouvelle approbation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस अब पुनः स्वीकृति के बिना आपके Mac को नियंत्रित नहीं कर पाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは再承認なしではMacを制御できなくなります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكن هذا الجهاز من التحكم في جهاز Mac الخاص بك بعد الآن دون إعادة الموافقة."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non potrà più controllare il tuo Mac senza una nuova approvazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya no podrá controlar su Mac sin una nueva aprobación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não poderá mais controlar seu Mac sem uma nova aprovação."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 재승인 없이는 더 이상 Mac을 제어할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство больше не сможет управлять вашим Mac без повторного одобрения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置未經重新核准將無法再控制您的 Mac。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz, yeniden onay almadan Mac'inizi artık kontrol edemeyecek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan uw Mac niet langer bedienen zonder nieuwe goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie będzie już mogło kontrolować Twojego Maca bez ponownego zatwierdzenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna enhet kommer inte längre att kunna styra din Mac utan nytt godkännande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้จะไม่สามารถควบคุม Mac ของคุณได้อีกต่อไปหากไม่ได้รับการอนุมัติใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này sẽ không thể điều khiển Mac của bạn nếu không được phê duyệt lại."
          }
        }
      }
    },
    "This will remove all trusted and revoked devices from this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This will remove all trusted and revoked devices from this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从此 Mac 移除所有受信任和已撤销的设备。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle vertrauenswürdigen und widerrufenen Geräte von diesem Mac entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera tous les appareils approuvés et révoqués de ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस Mac से सभी विश्वसनीय और निरस्त डिवाइसों को हटा देगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、このMacからすべての信頼済みおよび取り消し済みデバイスが削除されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة جميع الأجهزة الموثوقة والملغاة من جهاز Mac هذا."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuoverà tutti i dispositivi fidati e revocati da questo Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todos los dispositivos de confianza y revocados de este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá todos os dispositivos confiáveis e revogados deste Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 이 Mac에서 모든 신뢰 및 취소된 기기가 제거됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все доверенные и отозванные устройства с этого Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將移除此 Mac 上所有受信任和已撤銷的裝置。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu Mac'teki tüm güvenilir ve iptal edilmiş cihazları kaldıracaktır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle vertrouwde en ingetrokken apparaten van deze Mac verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich zaufanych i cofniętych urządzeń z tego Maca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort alla betrodda och återkallade enheter från denna Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบอุปกรณ์ที่เชื่อถือได้และถูกเพิกถอนทั้งหมดออกจาก Mac เครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tất cả thiết bị đáng tin cậy và bị thu hồi khỏi Mac này."
          }
        }
      }
    },
