          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les hôtes Vamp Control de confiance, la posture de connexion, les paramètres de confidentialité par défaut et le comportement du flux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्वसनीय Vamp Control होस्ट, कनेक्शन मुद्रा, गोपनीयता डिफ़ॉल्ट और स्ट्रीम व्यवहार प्रबंधित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci host Vamp Control fidati, postura di connessione, impostazioni predefinite sulla privacy e comportamento dello stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるVamp Controlホスト、接続ポスチャー、プライバシー既定値、ストリーム動作を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 Vamp Control 호스트, 연결 자세, 개인정보 기본값 및 스트림 동작을 관리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer vertrouwde Vamp Control-hosts, verbindingshouding, privacy-standaardinstellingen en streamgedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj zaufanymi hostami Vamp Control, postawą połączenia, domyślnymi ustawieniami prywatności i zachowaniem strumienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie hosts Vamp Control confiáveis, postura de conexão, padrões de privacidade e comportamento do stream."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте доверенными Vamp Control-хостами, режимом подключения, настройками конфиденциальности по умолчанию и поведением потока."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
