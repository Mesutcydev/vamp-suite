      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة مضيفي Vamp Control الموثوقين، ووضع الاتصال، وإعدادات الخصوصية الافتراضية، وسلوك البث."
          }
        },
        "de": {
          "stringUnit": {
