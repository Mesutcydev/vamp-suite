    "Ready to control your Vamp Control host over LAN or a trusted private relay.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز للتحكم في مضيف Vamp Control الخاص بك عبر الشبكة المحلية أو مرحل خاص موثوق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit, Ihren Vamp Control-Host über LAN oder ein vertrauenswürdiges privates Relay zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Ready to control your Vamp Control host over LAN or a trusted private relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo para controlar su host Vamp Control a través de LAN o un relay privado de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à contrôler votre hôte Vamp Control via LAN ou un relais privé de confiance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN या विश्वसनीय निजी रिले पर अपने Vamp Control होस्ट को नियंत्रित करने के लिए तैयार।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto a controllare il tuo host Vamp Control tramite LAN o un relay privato fidato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LANまたは信頼できるプライベートリレーを介してVamp Controlホストを制御する準備ができました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN 또는 신뢰할 수 있는 사설 릴레이를 통해 Vamp Control 호스트를 제어할 준비가 되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar om uw Vamp Control-host te bedienen via LAN of een vertrouwde privérelay."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowy do sterowania hostem Vamp Control przez LAN lub zaufany prywatny przekaźnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para controlar seu host Vamp Control via LAN ou um relay privado confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готов к управлению вашим Vamp Control-хостом через LAN или доверенный частный ретранслятор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo att styra din Vamp Control-värd via LAN eller ett betrott privat relä."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมที่จะควบคุมโฮสต์ Vamp Control ของคุณผ่าน LAN หรือรีเลย์ส่วนตัวที่เชื่อถือได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamp Control ana bilgisayarınızı LAN veya güvenilir bir özel röle üzerinden kontrol etmeye hazır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng điều khiển máy chủ Vamp Control của bạn qua LAN hoặc chuyển tiếp riêng tư đáng tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已准备就绪，可通过局域网或受信任的专用中继控制您的 Vamp Control 主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已準備好透過區域網路或受信任的專用中繼控制您的 Vamp Control 主機。"
          }
        }
      }
    },
