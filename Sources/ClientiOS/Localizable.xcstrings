    "when on, blocks all input injection regardless of session": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التشغيل، يمنع جميع حقن الإدخال بغض النظر عن الجلسة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wenn aktiviert, blockiert alle Eingabeinjektionen unabhängig von der Sitzung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "when on, blocks all input injection regardless of session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cuando está activado, bloquea toda inyección de entrada independientemente de la sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lorsqu'il est activé, bloque toute injection d'entrée quelle que soit la session"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, सत्र की परवाह किए बिना सभी इनपुट इंजेक्शन को ब्लॉक करता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "quando attivo, blocca tutte le iniezioni di input indipendentemente dalla sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンの場合、セッションに関係なくすべての入力注入をブロックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있으면 세션에 관계없이 모든 입력 주입을 차단합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "indien ingeschakeld, blokkeert alle invoerinjectie ongeacht de sessie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "po włączeniu blokuje wszystkie wstrzyknięcia wejściowe niezależnie od sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "quando ativado, bloqueia toda injeção de entrada independentemente da sessão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "при включении блокирует все вводы независимо от сеанса"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "när på, blockerar all inmatningsinjektion oavsett session"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด จะบล็อกการฉีดอินพุตทั้งหมดโดยไม่คำนึงถึงเซสชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "açıkken, oturumdan bağımsız olarak tüm giriş enjeksiyonunu engeller"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "khi bật, chặn tất cả việc tiêm đầu vào bất kể phiên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，无论会话状态如何，都会阻止所有输入注入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時，無論工作階段狀態如何，都會封鎖所有輸入注入"
          }
        }
      }
    },
