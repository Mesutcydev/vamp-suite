    "tap focus to open ios keyboard, or use quick keys directly": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على التركيز لفتح لوحة مفاتيح iOS، أو استخدم المفاتيح السريعة مباشرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus antippen, um die iOS-Tastatur zu öffnen, oder Quick Keys direkt verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "tap focus to open ios keyboard, or use quick keys directly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "toque el foco para abrir el teclado de iOS, o use las teclas rápidas directamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "appuyez sur le focus pour ouvrir le clavier iOS, ou utilisez les touches rapides directement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS कीबोर्ड खोलने के लिए फ़ोकस टैप करें, या सीधे क्विक की का उपयोग करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tocca il focus per aprire la tastiera iOS, o usa direttamente i tasti rapidi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスをタップしてiOSキーボードを開くか、クイックキーを直接使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스를 탭하여 iOS 키보드를 열거나 빠른 키를 직접 사용하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tik op focus om het iOS-toetsenbord te openen, of gebruik sneltoetsen rechtstreeks"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dotknij fokusu, aby otworzyć klawiaturę iOS, lub użyj klawiszy szybkich bezpośrednio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "toque no foco para abrir o teclado iOS, ou use teclas rápidas diretamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "нажмите на фокус, чтобы открыть клавиатуру iOS, или используйте быстрые клавиши напрямую"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "tryck på fokus för att öppna iOS-tangentbordet, eller använd snabbknappar direkt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะโฟกัสเพื่อเปิดแป้นพิมพ์ iOS หรือใช้ปุ่มลัดโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS klavyesini açmak için odağa dokunun veya doğrudan hızlı tuşları kullanın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chạm tiêu điểm để mở bàn phím iOS hoặc sử dụng phím nhanh trực tiếp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击聚焦以打开 iOS 键盘，或直接使用快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按焦點以開啟 iOS 鍵盤，或直接使用快速鍵"
          }
        }
      }
    },
