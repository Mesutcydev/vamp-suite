    "all traffic stays on your local network — no external relay": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع حركة المرور تبقى على شبكتك المحلية — لا يوجد مرحل خارجي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der gesamte Datenverkehr bleibt in Ihrem lokalen Netzwerk — kein externes Relay"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "all traffic stays on your local network — no external relay"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "todo el tráfico permanece en su red local — sin retransmisión externa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tout le trafic reste sur votre réseau local — aucun relais externe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी ट्रैफ़िक आपके स्थानीय नेटवर्क पर रहता है — कोई बाहरी रिले नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tutto il traffico rimane sulla tua rete locale — nessun relay esterno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのトラフィックはローカルネットワーク内のみ — 外部リレーなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 트래픽이 로컬 네트워크에만 머무릅니다 — 외부 릴레이 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "al het verkeer blijft op uw lokale netwerk — geen externe relay"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cały ruch pozostaje w sieci lokalnej — brak zewnętrznego przekaźnika"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "todo o tráfego permanece na sua rede local — sem retransmissão externa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "весь трафик остается в вашей локальной сети — без внешней ретрансляции"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "all trafik stannar på ditt lokala nätverk — inget externt relä"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรับส่งข้อมูลทั้งหมดอยู่บนเครือข่ายท้องถิ่นของคุณ — ไม่มีรีเลย์ภายนอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tüm trafik yerel ağınızda kalır — harici röle yok"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
