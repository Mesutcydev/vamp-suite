    "A secure command center for LAN-first remote control, trusted pairing, keyboard shortcuts, and relay-ready outside access.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مركز قيادة آمن للتحكم عن بُعد عبر الشبكة المحلية أولاً، والاقتران الموثوق، واختصارات لوحة المفاتيح، والوصول الخارجي الجاهز للترحيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sicheres Kommandozentrum für LAN-basierte Fernsteuerung, vertrauenswürdige Kopplung, Tastenkombinationen und relaisbereiten externen Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A secure command center for LAN-first remote control, trusted pairing, keyboard shortcuts, and relay-ready outside access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un centro de comando seguro para control remoto con prioridad LAN, emparejamiento de confianza, atajos de teclado y acceso externo listo para retransmisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un centre de commande sécurisé pour le contrôle à distance prioritaire LAN, l'appairage de confiance, les raccourcis clavier et l'accès externe prêt pour le relais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN-प्रथम रिमोट कंट्रोल, विश्वसनीय पेयरिंग, कीबोर्ड शॉर्टकट और रिले-रेडी बाहरी पहुंच के लिए एक सुरक्षित कमांड सेंटर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un centro di comando sicuro per il controllo remoto LAN-first, l'abbinamento fidato, le scorciatoie da tastiera e l'accesso esterno pronto per il relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN優先のリモートコントロール、信頼できるペアリング、キーボードショートカット、リレー対応の外部アクセスを備えた安全なコマンドセンター。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN 우선 원격 제어, 신뢰할 수 있는 페어링, 키보드 단축키 및 릴레이 지원 외부 접근을 위한 안전한 명령 센터."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een veilig commandocentrum voor LAN-eerst afstandsbediening, vertrouwde koppeling, sneltoetsen en relay-ready externe toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczne centrum dowodzenia dla zdalnego sterowania z priorytetem LAN, zaufanego parowania, skrótów klawiaturowych i dostępu zewnętrznego gotowego na przekazywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um centro de comando seguro para controle remoto com prioridade LAN, pareamento confiável, atalhos de teclado e acesso externo pronto para retransmissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасный командный центр для удаленного управления с приоритетом LAN, доверенного сопряжения, сочетаний клавиш и внешнего доступа с поддержкой ретрансляции."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett säkert kommandocenter för LAN-först fjärrkontroll, betrodd parkoppling, tangentbordsgenvägar och reläredo extern åtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ศูนย์บัญชาการที่ปลอดภัยสำหรับการควบคุมระยะไกลผ่าน LAN ก่อน การจับคู่ที่เชื่อถือได้ แป้นพิมพ์ลัด และการเข้าถึงภายนอกที่พร้อมส่งต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN öncelikli uzaktan kontrol, güvenilir eşleştirme, klavye kısayolları ve röle hazır dış erişim için güvenli bir komut merkezi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trung tâm chỉ huy an toàn cho điều khiển từ xa ưu tiên LAN, ghép nối tin cậy, phím tắt bàn phím và truy cập bên ngoài sẵn sàng chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个安全的命令中心，支持局域网优先的远程控制、受信任配对、键盘快捷键以及支持中继的外部访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個安全的命令中心，支援區域網路優先的遠端控制、受信任配對、鍵盤快捷鍵以及支援中繼的外部存取。"
          }
        }
      }
    },
