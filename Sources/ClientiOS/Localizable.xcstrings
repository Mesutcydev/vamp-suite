    "coordinates bounded, control chars filtered, dangerous shortcuts blocked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإحداثيات محدودة، أحرف التحكم مصفاة، الاختصارات الخطيرة محظورة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinaten begrenzt, Steuerzeichen gefiltert, gefährliche Tastenkombinationen blockiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "coordinates bounded, control chars filtered, dangerous shortcuts blocked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "coordenadas acotadas, caracteres de control filtrados, atajos peligrosos bloqueados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "coordonnées limitées, caractères de contrôle filtrés, raccourcis dangereux bloqués"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशांक सीमित, नियंत्रण वर्ण फ़िल्टर किए गए, खतरनाक शॉर्टकट अवरुद्ध"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "coordinate limitate, caratteri di controllo filtrati, scorciatoie pericolose bloccate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座標は制限され、制御文字はフィルタリングされ、危険なショートカットはブロックされます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌표 경계 설정, 제어 문자 필터링, 위험한 단축키 차단"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "coördinaten begrensd, besturingstekens gefilterd, gevaarlijke sneltoetsen geblokkeerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "współrzędne ograniczone, znaki sterujące filtrowane, niebezpieczne skróty blokowane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "coordenadas limitadas, caracteres de controle filtrados, atalhos perigosos bloqueados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "координаты ограничены, управляющие символы отфильтрованы, опасные сочетания заблокированы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "koordinater begränsade, kontrolltecken filtrerade, farliga genvägar blockerade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบเขตพิกัด กรองอักขระควบคุม บล็อกทางลัดอันตราย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "koordinatlar sınırlı, kontrol karakterleri filtrelendi, tehlikeli kısayollar engellendi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tọa độ bị giới hạn, ký tự điều khiển bị lọc, phím tắt nguy hiểm bị chặn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
