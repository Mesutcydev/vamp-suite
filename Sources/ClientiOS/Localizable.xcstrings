    "Reduce energy usage and favor steadier thermals.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقليل استهلاك الطاقة وتفضيل درجات حرارة أكثر استقرارًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energieverbrauch reduzieren und stabilere Temperaturen bevorzugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reduce energy usage and favor steadier thermals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca el consumo de energía y favorezca temperaturas más estables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la consommation d'énergie et favoriser des températures plus stables."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊर्जा उपयोग कम करें और स्थिर तापमान को प्राथमिकता दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il consumo energetico e favorisci temperature più stabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギー使用量を削減し、より安定した温度を優先します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지 사용량을 줄이고 더 안정적인 온도를 선호합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder het energieverbruik en geef de voorkeur aan stabielere temperaturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz zużycie energii i zapewnij bardziej stabilne temperatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o uso de energia e favoreça temperaturas mais estáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижайте энергопотребление и обеспечивайте более стабильный температурный режим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska energiförbrukningen och gynna jämnare temperaturer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดการใช้พลังงานและช่วยให้อุณหภูมิคงที่มากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerji kullanımını azaltın ve daha istikrarlı sıcaklıkları tercih edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm sử dụng năng lượng và ưu tiên nhiệt độ ổn định hơn."
          }
        },
        "zh-Hans": {
